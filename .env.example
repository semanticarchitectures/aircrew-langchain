# Required for live crews (not needed for --crew scripted)
ANTHROPIC_API_KEY=

# Model used by every role unless overridden per role.
# Default matches the original airdrop-alpha so runs are comparable.
AIRDROP_MODEL=anthropic:claude-sonnet-4-6
# AIRDROP_MODEL_ATC=anthropic:claude-haiku-4-5-20251001

# LangSmith tracing is OFF unless you turn it on. Traces are sent to a hosted service.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=airdrop-alpha
